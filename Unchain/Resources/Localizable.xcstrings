        }
      }
    },
    "No track points found in this GPX file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Track-Punkte in dieser GPX-Datei gefunden."
          }
        }
      }
    },
    "This GPX track is missing elevation data (<ele>) for at least one point. Unchain needs elevation in the file itself to derive a grade profile – it doesn't look elevation up online.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesem GPX-Track fehlen bei mindestens einem Punkt Höhendaten (<ele>). Unchain braucht die Höhe in der Datei selbst, um ein Steigungsprofil zu berechnen – sie wird nicht online nachgeschlagen."
          }
        }
      }
    },
    "Health data isn't available on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-Daten sind auf diesem Gerät nicht verfügbar."
          }
        }
      }
    },
    "Unchain isn't allowed to save workouts to Health.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unchain darf keine Workouts in Health speichern."
          }
        }
      }
    },
