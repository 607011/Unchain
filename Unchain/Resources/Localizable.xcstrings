        }
      }
    },
    "The file couldn't be read as text.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht als Text gelesen werden."
          }
        }
      }
    },
    "No [COURSE DATA] section found – is this really an .erg/.mrc file?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein [COURSE DATA]-Abschnitt gefunden – ist das wirklich eine .erg-/.mrc-Datei?"
          }
        }
      }
    },
    "Couldn't understand \"%@\" – expected something like \"5min 250W\" or \"3x(...)\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht verstanden werden – erwartet wurde z. B. „5min 250W“ oder „3x(...)“."
          }
        }
      }
    },
    "Couldn't understand the duration \"%@\" – use e.g. \"10min\" or \"90s\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dauer „%@“ konnte nicht verstanden werden – nutze z. B. „10min“ oder „90s“."
          }
        }
      }
    },
    "Couldn't understand the target \"%@\" – use e.g. \"250W\" or \"75%%FTP\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zielwert „%@“ konnte nicht verstanden werden – nutze z. B. „250W“ oder „75%%FTP“."
          }
        }
      }
    },
    "This workout uses %FTP, but no FTP is set – add one in Settings first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Workout nutzt %FTP, aber es ist keine FTP eingetragen – trage zuerst eine in den Einstellungen ein."
          }
        }
